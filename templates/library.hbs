<div class="jbs-root"><section class="jbs-left"><h2><i class="fa-solid fa-book-open"></i> D&D-Zauberbibliothek</h2><input class="jbs-search" type="search" data-search placeholder="Zauber suchen..." value="{{search}}"><div class="jbs-filters"><select data-level><option value="all">Alle Grade</option>{{#each levels}}<option value="{{this}}">Grad {{this}}</option>{{/each}}</select><select data-edition><option value="all">Beide Fassungen</option><option value="2014">2014</option><option value="2024">2024</option><option value="?">Unbekannt</option></select></div><div class="jbs-status">{{rows.length}} Zaubervarianten · {{issues}} Lesefehler</div><div class="jbs-list">{{#each rows}}<button type="button" class="jbs-row {{#if selected}}selected{{/if}}" data-select="{{key}}" data-name="{{name}}" data-level="{{level}}" data-edition="{{edition}}"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>Grad {{level}} · {{edition}}</small></span></button>{{/each}}</div><button type="button" data-refresh>Kompendien neu einlesen</button></section><section class="jbs-right">{{#if chosen}}<div class="jbs-header"><img src="{{chosen.img}}" alt=""><div><h2>{{chosen.name}}</h2><small>Grad {{chosen.level}} · {{chosen.edition}}</small></div></div><p>{{chosen.effectLabel}}</p>{{#if chosen.fallback}}<p class="jbs-warn">Allgemeine Ersatzanimation – kann vom Zauber abweichen.</p>{{/if}}{{#if chosen.wall}}<label>Form <select data-variant><option value="line">Gerade Feuerwand</option><option value="ring">Feuerring</option></select></label>{{/if}}<label><input type="checkbox" data-persist {{#if chosen.persistent}}checked{{/if}}> Effekt dauerhaft auf der Karte lassen</label><button type="button" data-play>Auf Karte ausführen</button>{{else}}<p>Wähle links einen Zauber aus.</p>{{/if}}<hr><h3>Aktive Effekte ({{effects.length}})</h3><div class="jbs-effects">{{#each effects}}<div class="jbs-effect"><span>{{name}}</span><button type="button" data-remove="{{id}}">Entfernen</button></div>{{else}}<p>Keine dauerhaften Effekte dieser Bibliothek in der Szene.</p>{{/each}}</div><button type="button" data-manager>Sequencer-Effektverwaltung öffnen</button><p class="jbs-status jbs-push">Nur Visualisierung; keine automatische Regelauswertung.</p></section></div>